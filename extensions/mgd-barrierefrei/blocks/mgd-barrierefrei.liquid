{{ 'mgd-barrierefrei.css' | asset_url | stylesheet_tag }}
<div class="mgd-a11y" data-mgd-a11y data-position="{{ block.settings.position | escape }}" style="--mgd-a11y-accent: {{ block.settings.accent_color | escape }}">
  <button class="mgd-a11y__trigger" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="mgd-a11y-dialog-{{ block.id }}">
    <span aria-hidden="true">♿</span><span>{{ block.settings.button_label | escape }}</span>
  </button>
  <section class="mgd-a11y__dialog" id="mgd-a11y-dialog-{{ block.id }}" role="dialog" aria-modal="true" aria-label="{{ block.settings.button_label | escape }}" hidden tabindex="-1">
    <header><h2>{{ block.settings.button_label | escape }}</h2><button type="button" class="mgd-a11y__close" aria-label="Schließen">×</button></header>
    <p>Darstellung nur für dieses Gerät anpassen.</p>
    <div class="mgd-a11y__actions">
      <button type="button" data-mgd-a11y-action="contrast">Kontrast</button><button type="button" data-mgd-a11y-action="gray">Graustufen</button><button type="button" data-mgd-a11y-action="focus">Fokus</button><button type="button" data-mgd-a11y-action="font-up">Schrift +</button><button type="button" data-mgd-a11y-action="font-down">Schrift −</button><button type="button" data-mgd-a11y-action="motion">Bewegung stoppen</button><button type="button" data-mgd-a11y-action="reset">Zurücksetzen</button>
    </div>
    {% if block.settings.statement_url != blank %}<p><a href="{{ block.settings.statement_url }}">Erklärung zur Barrierefreiheit</a></p>{% endif %}
    <p class="mgd-a11y__credit"><a href="https://michael-gahn.de" target="_blank" rel="noopener noreferrer">Michael-Gahn.de</a></p>
  </section>
</div>
<script src="{{ 'mgd-barrierefrei.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "MGD Barrierefrei",
  "target": "body",
  "settings": [
    {"type":"select","id":"position","label":"Position","default":"left","options":[{"value":"left","label":"Unten links"},{"value":"right","label":"Unten rechts"}]},
    {"type":"text","id":"button_label","label":"Beschriftung","default":"Barrierefreiheit"},
    {"type":"color","id":"accent_color","label":"Akzentfarbe","default":"#b91c1c"},
    {"type":"url","id":"statement_url","label":"Link zur Erklärung zur Barrierefreiheit"}
  ]
}
{% endschema %}
